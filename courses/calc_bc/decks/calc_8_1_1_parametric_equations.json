  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "For parametric equations x(t), y(t), the slope dy/dx is:",
      "choices": [
        {
          "id": "a",
          "text": "(dy/dt)/(dx/dt)"
        },
        {
          "id": "b",
          "text": "dy/dt · dx/dt"
        },
        {
          "id": "c",
          "text": "dx/dt ÷ dy/dt"
        },
        {
          "id": "d",
          "text": "y/x"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "This is the chain rule for parametric curves.",
      "hint": null,
      "difficulty": "easy",
      "subskill_tags": [
        "parametric"
      ],
      "media": null
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "If x=t² and y=t³, then dy/dx =",
      "choices": [
        {
          "id": "a",
          "text": "3t²/2t"
        },
        {
          "id": "b",
          "text": "2t/3t²"
        },
        {
          "id": "c",
          "text": "t"
        },
        {
          "id": "d",
          "text": "3/2"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Compute dy/dt and dx/dt first.",
      "hint": null,
      "difficulty": "easy",
      "subskill_tags": [
        "parametric"
      ],
      "media": null
    },
    {
      "id": "q3",
      "type": "numeric",
      "prompt": "If x=t² and y=t³, find dy/dx at t=1.",
      "correct_numeric": 1.5,
      "tolerance": 0.02,
      "accepted_formats": [
        "integer",
        "decimal",
        "fraction"
      ],
      "explanation": "dy/dx = (3t²)/(2t)=3t/2, so at t=1 it is 3/2.",
      "hint": null,
      "difficulty": "easy",
      "subskill_tags": [
        "parametric"
      ],
      "media": null
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "A parametric curve can be traced more than once because:",
      "choices": [
        {
          "id": "a",
          "text": "Different t-values can give the same point"
        },
        {
          "id": "b",
          "text": "It always forms circles"
        },
        {
          "id": "c",
          "text": "dy/dx is undefined"
        },
        {
          "id": "d",
          "text": "x must be linear"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Parametric motion depends on time, not just position.",
      "hint": null,
      "difficulty": "easy",
      "subskill_tags": [
        "parametric"
      ],
      "media": null
    },
    {
