  "questions": [
    {
      "id": "calc_1_3_1_q1",
      "type": "multiple_choice",
      "prompt": "A function is continuous at x=a if:",
      "choices": [
        {
          "id": "a",
          "text": "the graph has a sharp turn"
        },
        {
          "id": "b",
          "text": "the limit exists and equals f(a)"
        },
        {
          "id": "c",
          "text": "f'(a)=0"
        },
        {
          "id": "d",
          "text": "the function is increasing"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Continuity needs existence of the function, the limit, and equality of the two.",
      "hint": "Use the continuity checklist.",
      "difficulty": "medium",
      "subskill_tags": [
        "continuity"
      ],
      "media": null
    },
    {
      "id": "calc_1_3_1_q2",
      "type": "graph_multiple_choice",
      "prompt": "Which graph is discontinuous at the marked x-value?",
      "choices": [
        {
          "id": "a",
          "text": "Graph 1"
        },
        {
          "id": "b",
          "text": "Graph 2"
        },
        {
          "id": "c",
          "text": "Graph 3"
        },
        {
          "id": "d",
          "text": "Graph 4"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "A jump or hole breaks continuity.",
