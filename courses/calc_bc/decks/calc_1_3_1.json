    {
      "id": "calc_1_3_1_q3",
      "type": "multiple_choice",
      "prompt": "A removable discontinuity usually looks like:",
      "choices": [
        {
          "id": "a",
          "text": "a vertical asymptote"
        },
        {
          "id": "b",
          "text": "a hole"
        },
        {
          "id": "c",
          "text": "a cusp"
        },
        {
          "id": "d",
          "text": "an endpoint"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Removable discontinuities are holes.",
      "hint": "Think 'missing point.'",
      "difficulty": "medium",
      "subskill_tags": [
        "removable"
      ],
      "media": null
    },
    {
      "id": "calc_1_3_1_q4",
      "type": "graph_multiple_choice",
      "prompt": "If the graph is continuous on [a,b], IVT guarantees:",
      "choices": [
        {
          "id": "a",
          "text": "every slope occurs"
        },
        {
          "id": "b",
          "text": "every y-value between f(a) and f(b) occurs"
        },
        {
          "id": "c",
          "text": "the derivative exists"
        },
        {
          "id": "d",
          "text": "the function is linear"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "IVT guarantees intermediate output values on a closed interval.",
      "hint": "Think outputs between endpoint outputs.",
      "difficulty": "medium",
      "subskill_tags": [
        "ivt"
      ],
      "media": {
        "image": "media/images/calc_1_3_1_2.png"
      }
    },
    {
      "id": "calc_1_3_1_q5",
      "type": "multiple_choice",
      "prompt": "Which feature causes continuity to fail?",
      "choices": [
        {
          "id": "a",
          "text": "A constant slope"
        },
        {
          "id": "b",
          "text": "A hole at x=a"
        },
        {
          "id": "c",
          "text": "Being positive"
        },
        {
          "id": "d",
          "text": "Having a maximum"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A hole means the function value is missing or mismatched.",
      "hint": "Look for a missing point.",
      "difficulty": "medium",
      "subskill_tags": [
        "continuity-fail"
      ],
      "media": null
    },
    {
      "id": "calc_1_3_1_q6",
      "type": "graph_multiple_choice",
      "prompt": "For the piecewise function card, continuity at x=2 would require the two sides to:",
      "choices": [
        {
          "id": "a",
          "text": "be increasing"
        },
        {
          "id": "b",
          "text": "have the same limit value"
        },
        {
          "id": "c",
          "text": "have opposite signs"
        },
        {
          "id": "d",
          "text": "both equal 0"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "The left and right must meet at one common value.",
      "hint": "Match the one-sided limits.",
      "difficulty": "medium",
      "subskill_tags": [
        "piecewise"
      ],
      "media": {
        "image": "media/images/calc_1_3_1_3.png"
      }
    },
    {
      "id": "calc_1_3_1_q7",
      "type": "multiple_choice",
      "prompt": "A jump discontinuity happens when:",
      "choices": [
        {
          "id": "a",
          "text": "outputs blow up"
        },
        {
          "id": "b",
          "text": "the one-sided limits exist but are unequal"
        },
        {
          "id": "c",
          "text": "the graph only touches the x-axis"
        },
        {
          "id": "d",
          "text": "the derivative is 0"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A jump has two finite but different side limits.",
      "hint": "Think separate levels.",
      "difficulty": "medium",
      "subskill_tags": [
        "jump"
      ],
      "media": null
    },
