      "id": "calc_1_1_1_q1",
      "type": "multiple_choice",
      "prompt": "If f(3)=7, what does that mean?",
      "choices": [
        {
          "id": "a",
          "text": "The slope at x=3 is 7"
        },
        {
          "id": "b",
          "text": "The output is 7 when x=3"
        },
        {
          "id": "c",
          "text": "The input is 7 when x=3"
        },
        {
          "id": "d",
          "text": "f has a zero at x=7"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Function notation maps an input to an output.",
      "hint": "Read f(3) as 'the value of f at 3.'",
      "difficulty": "easy",
      "subskill_tags": [
        "function-notation"
      ],
      "media": null
