      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Which statement best describes a removable discontinuity?",
      "choices": [
        {
          "id": "a",
          "text": "The limit exists but f(a) is missing or mismatched"
        },
        {
          "id": "b",
          "text": "The function has a vertical asymptote"
        },
        {
          "id": "c",
          "text": "The one-sided limits are unequal"
        },
        {
          "id": "d",
          "text": "The function oscillates wildly"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "A removable discontinuity is a hole that could be fixed by redefining one point.",
      "hint": null,
      "difficulty": "easy",
      "subskill_tags": [
        "continuity"
      ],
      "media": null
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "If a function is continuous on [2,5], then the Intermediate Value Theorem guarantees it takes every y-value between:",
      "choices": [
        {
          "id": "a",
          "text": "f(2) and f(5)"
        },
        {
          "id": "b",
          "text": "2 and 5"
        },
        {
          "id": "c",
          "text": "0 and 1"
        },
        {
          "id": "d",
          "text": "Its minimum and maximum x-values"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "IVT is about output values between the endpoint outputs.",
      "hint": null,
      "difficulty": "easy",
      "subskill_tags": [
        "IVT"
      ],
      "media": null
    },
    {
