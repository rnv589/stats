      "prompt": "Which measure of center is more resistant to outliers?",
      "choices": [
        {
          "id": "a",
          "text": "Mean"
        },
        {
          "id": "b",
          "text": "Median"
        },
        {
          "id": "c",
          "text": "Range"
        },
        {
          "id": "d",
          "text": "Standard deviation"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "The median is resistant because extreme values do not pull it much.",
      "hint": "Think resistant to extreme values.",
      "difficulty": "easy",
      "subskill_tags": [
        "center",
        "median"
      ],
