  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "A 95% confidence interval means:",
      "choices": [
        {
          "id": "a",
          "text": "95% of sample values lie in the interval"
        },
        {
          "id": "b",
          "text": "In repeated sampling, about 95% of intervals from the method capture the true parameter"
        },
        {
          "id": "c",
          "text": "There is a 95% chance this fixed parameter changes"
        },
        {
          "id": "d",
          "text": "95% of the population is in the interval"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Confidence level refers to long-run capture rate of the method.",
      "hint": "It is about the method, not the parameter moving.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "interpretation"
      ],
      "media": {
        "image": "media/images/stats_7_1_1_confidence_level_and_margin_of_error_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "The margin of error is:",
      "choices": [
        {
          "id": "a",
          "text": "Half the width of the interval"
        },
        {
          "id": "b",
          "text": "The full width of the interval"
        },
        {
          "id": "c",
          "text": "Always equal to the statistic"
        },
        {
          "id": "d",
          "text": "The p-value"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Margin of error is the distance from the estimate to either endpoint.",
      "hint": "Half-width.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "moe"
      ],
      "media": {
        "image": "media/images/stats_7_1_1_confidence_level_and_margin_of_error_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "If confidence level increases from 90% to 99%, the interval usually becomes:",
      "choices": [
        {
          "id": "a",
          "text": "Narrower"
        },
        {
          "id": "b",
          "text": "Wider"
        },
        {
          "id": "c",
          "text": "Unchanged"
        },
        {
          "id": "d",
          "text": "Negative"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "More confidence requires a wider interval.",
      "hint": "More certainty costs width.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "confidence-level"
      ],
      "media": {
        "image": "media/images/stats_7_1_1_confidence_level_and_margin_of_error_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "If sample size increases, the margin of error generally:",
      "choices": [
        {
          "id": "a",
          "text": "Increases"
        },
        {
          "id": "b",
          "text": "Decreases"
        },
        {
          "id": "c",
          "text": "Stays same"
        },
        {
          "id": "d",
          "text": "Becomes the parameter"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Larger samples reduce standard error and margin of error.",
      "hint": "More data, less uncertainty.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "sample-size"
      ],
      "media": {
        "image": "media/images/stats_7_1_1_confidence_level_and_margin_of_error_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "Which is a correct interpretation? ",
      "choices": [
        {
          "id": "a",
          "text": "There is a 95% chance the true mean is in this interval after it is computed"
        },
        {
          "id": "b",
          "text": "We are 95% confident the method used would capture the true mean in the long run"
        },
        {
          "id": "c",
          "text": "95% of observations are inside the interval"
        },
        {
          "id": "d",
          "text": "95% of sample means equal the parameter"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "This phrasing respects frequentist confidence logic.",
      "hint": "Avoid probability on a fixed parameter.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "interpretation"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "A narrower confidence interval indicates:",
      "choices": [
        {
          "id": "a",
          "text": "More precision"
        },
        {
          "id": "b",
          "text": "Less precision"
