      "id": "q1",
      "type": "multiple_choice",
      "prompt": "A random sample of students is used to test whether the population proportion who prefer online homework is 0.6. Which test?",
      "choices": [
        {
          "id": "a",
          "text": "One-proportion z-test"
        },
        {
          "id": "b",
          "text": "One-sample t-test"
        },
        {
          "id": "c",
          "text": "Two-proportion z-test"
        },
        {
          "id": "d",
          "text": "Matched-pairs t-test"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "One categorical sample and one proportion parameter means a one-proportion z-test.",
      "hint": "Identify variable type and number of samples.",
      "difficulty": "hard",
      "subskill_tags": [
        "hypothesis-test",
        "procedure-selection"
      ],
      "media": {
