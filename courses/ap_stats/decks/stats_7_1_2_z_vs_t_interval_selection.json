      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Which interval is used for a population mean when \u03c3 is unknown and data are roughly normal?",
      "choices": [
        {
          "id": "a",
          "text": "z-interval for p"
        },
        {
          "id": "b",
          "text": "t-interval for a mean"
        },
        {
          "id": "c",
          "text": "Two-proportion z-interval"
        },
        {
          "id": "d",
          "text": "No interval possible"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Unknown \u03c3 for a mean leads to a t-interval.",
      "hint": "Think mean + unknown population SD.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "procedure-selection"
      ],
      "media": {
