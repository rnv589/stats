  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "When some groups in the population are left out of the sampling frame, this is:",
      "choices": [
        {
          "id": "a",
          "text": "Nonresponse"
        },
        {
          "id": "b",
          "text": "Undercoverage"
        },
        {
          "id": "c",
          "text": "Response bias"
        },
        {
          "id": "d",
          "text": "Sampling distribution"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Undercoverage happens when part of the population is not well represented.",
      "hint": "Think missing groups.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "undercoverage"
      ],
      "media": {
        "image": "media/images/stats_3_2_2_sources_of_bias_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "When selected people do not respond, this is:",
      "choices": [
        {
          "id": "a",
          "text": "Wording bias"
        },
        {
          "id": "b",
          "text": "Undercoverage"
        },
        {
          "id": "c",
          "text": "Nonresponse"
        },
        {
          "id": "d",
          "text": "Confounding"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "Nonresponse happens after selection when people fail to answer.",
      "hint": "Chosen but silent.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "nonresponse"
      ],
      "media": {
        "image": "media/images/stats_3_2_2_sources_of_bias_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "A survey asking 'Don't you agree this policy is unfair?' has:",
      "choices": [
        {
          "id": "a",
          "text": "Cluster bias"
        },
        {
          "id": "b",
          "text": "Wording bias"
        },
        {
          "id": "c",
          "text": "Sampling variability"
        },
        {
          "id": "d",
          "text": "Randomization"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Leading wording can bias responses.",
      "hint": "The wording pushes people.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "wording"
      ],
      "media": {
        "image": "media/images/stats_3_2_2_sources_of_bias_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "A call-in poll on a news website is most vulnerable to:",
      "choices": [
        {
          "id": "a",
          "text": "Voluntary response bias"
        },
        {
          "id": "b",
          "text": "Random assignment bias"
        },
        {
          "id": "c",
          "text": "Cluster error"
        },
        {
          "id": "d",
          "text": "Experimental confounding"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "People choose whether to respond, so voluntary response bias is likely.",
      "hint": "Self-selected respondents.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "voluntary-response"
      ],
      "media": {
        "image": "media/images/stats_3_2_2_sources_of_bias_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "A sample from school email misses students who rarely check email. This is:",
      "choices": [
        {
          "id": "a",
          "text": "Undercoverage"
        },
        {
          "id": "b",
          "text": "Confounding"
        },
        {
          "id": "c",
          "text": "Placebo effect"
        },
        {
          "id": "d",
          "text": "Blocking"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Part of the population is less likely to be reached.",
      "hint": "Think missing access.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "undercoverage"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "Bias differs from random sampling variability because bias:",
      "choices": [
        {
          "id": "a",
          "text": "Gets smaller with repetition automatically"
        },
        {
          "id": "b",
          "text": "Pushes results in a systematic direction"
        },
        {
          "id": "c",
          "text": "Is just another word for spread"
        },
        {
          "id": "d",
          "text": "Only appears in experiments"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Bias systematically pulls results away from truth.",
      "hint": "Think directional error.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias"
      ],
      "media": null
    },
    {
      "id": "q7",
      "type": "multiple_choice",
      "prompt": "Which change best reduces wording bias?",
      "choices": [
        {
          "id": "a",
          "text": "Use more emotional words"
        },
        {
          "id": "b",
          "text": "Use neutral language"
        },
        {
          "id": "c",
          "text": "Ask only volunteers"
        },
        {
          "id": "d",
          "text": "Shorten the sample"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Neutral wording reduces leading effects.",
      "hint": "Keep the prompt balanced.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "wording"
      ],
      "media": null
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "If a survey about school lunches is given only to students buying lunch that day, the main concern is:",
      "choices": [
        {
          "id": "a",
          "text": "Random assignment"
        },
        {
          "id": "b",
          "text": "Undercoverage"
        },
        {
          "id": "c",
          "text": "Placebo effect"
        },
        {
          "id": "d",
          "text": "Power"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Students who bring lunch are excluded, so undercoverage is likely.",
      "hint": "Some population members are missed.",
      "difficulty": "medium",
      "subskill_tags": [
        "bias",
        "undercoverage"
      ],
      "media": null
    },
    {
      "id": "q9",
      "type": "multiple_choice",
      "prompt": "Generalizability means:",
      "choices": [
        {
          "id": "a",
          "text": "Whether a causal conclusion is possible"
        },
        {
          "id": "b",
          "text": "Whether results can apply to a broader population"
        },
        {
          "id": "c",
          "text": "Whether p-value is small"
        },
        {
          "id": "d",
          "text": "Whether a boxplot has outliers"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Generalizability is about applying results beyond the sample.",
      "hint": "Think broader use.",
      "difficulty": "medium",
      "subskill_tags": [
        "validity",
        "generalizability"
      ],
      "media": null
    },
    {
      "id": "q10",
      "type": "multiple_choice",
      "prompt": "Random sampling mainly helps with:",
      "choices": [
        {
          "id": "a",
          "text": "Causal conclusions"
        },
        {
          "id": "b",
          "text": "Representative data and generalizability"
        },
        {
          "id": "c",
          "text": "Blinding"
        },
        {
          "id": "d",
          "text": "Placebo effects"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Random sampling supports broader representation of the population.",
      "hint": "Sampling is about representativeness.",
      "difficulty": "medium",
      "subskill_tags": [
        "sampling",
        "generalizability"
      ],
      "media": null
    }
  ]
}