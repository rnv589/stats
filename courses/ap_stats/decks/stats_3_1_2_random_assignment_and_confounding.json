  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Random assignment is used to:",
      "choices": [
        {
          "id": "a",
          "text": "Choose the population"
        },
        {
          "id": "b",
          "text": "Reduce bias between treatment groups"
        },
        {
          "id": "c",
          "text": "Guarantee a large sample"
        },
        {
          "id": "d",
          "text": "Remove all variation"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Random assignment balances groups on average.",
      "hint": "It helps make groups comparable.",
      "difficulty": "medium",
      "subskill_tags": [
        "randomization"
      ],
      "media": {
        "image": "media/images/stats_3_1_2_random_assignment_and_confounding_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Confounding occurs when:",
      "choices": [
        {
          "id": "a",
          "text": "A single variable's effect can be separated clearly"
        },
        {
          "id": "b",
          "text": "Two variables' effects are mixed together"
        },
        {
          "id": "c",
          "text": "The sample is random"
        },
        {
          "id": "d",
          "text": "The graph is skewed"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Confounding mixes effects so they cannot be separated.",
      "hint": "Think mixed-up explanations.",
      "difficulty": "medium",
      "subskill_tags": [
        "confounding"
      ],
      "media": {
        "image": "media/images/stats_3_1_2_random_assignment_and_confounding_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Which situation is most likely confounded?",
      "choices": [
        {
          "id": "a",
          "text": "Students randomly assigned to tutors"
        },
        {
          "id": "b",
          "text": "People choose whether to take a supplement, then health is measured"
        },
        {
          "id": "c",
          "text": "Treatments assigned by coin flip"
        },
        {
          "id": "d",
          "text": "A lab uses identical conditions"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Self-selection can mix treatment effects with preexisting differences.",
      "hint": "Think lurking differences.",
      "difficulty": "medium",
      "subskill_tags": [
        "confounding"
      ],
      "media": {
        "image": "media/images/stats_3_1_2_random_assignment_and_confounding_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Why does random assignment help with confounding?",
      "choices": [
        {
          "id": "a",
          "text": "It removes all variables"
        },
        {
          "id": "b",
          "text": "It helps create comparable groups"
        },
        {
          "id": "c",
          "text": "It proves the null hypothesis"
        },
        {
          "id": "d",
          "text": "It increases the population"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Comparable groups reduce the influence of lurking variables.",
      "hint": "Random assignment fights confounding.",
      "difficulty": "medium",
      "subskill_tags": [
        "randomization",
        "confounding"
      ],
      "media": {
        "image": "media/images/stats_3_1_2_random_assignment_and_confounding_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "Blinding helps mainly by reducing:",
      "choices": [
        {
          "id": "a",
          "text": "Sampling error"
        },
        {
          "id": "b",
          "text": "Response bias and placebo effects"
        },
        {
          "id": "c",
          "text": "Population size"
        },
        {
          "id": "d",
          "text": "Skewness"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Blinding limits expectation effects.",
      "hint": "Think hidden treatment knowledge.",
      "difficulty": "medium",
      "subskill_tags": [
        "blinding"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "A placebo is:",
      "choices": [
        {
          "id": "a",
          "text": "The response variable"
        },
        {
          "id": "b",
          "text": "A fake treatment"
        },
        {
          "id": "c",
          "text": "A confounding variable"
        },
        {
          "id": "d",
          "text": "A random sample"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A placebo mimics treatment without the active ingredient.",
      "hint": "Used for comparison.",
      "difficulty": "medium",
      "subskill_tags": [
        "placebo"
      ],
      "media": null
    },
    {
      "id": "q7",
      "type": "multiple_choice",
      "prompt": "Which design feature most directly supports cause and effect?",
      "choices": [
        {
          "id": "a",
          "text": "Random sampling only"
        },
        {
          "id": "b",
          "text": "Random assignment to treatments"
        },
        {
          "id": "c",
          "text": "Large graph"
        },
        {
          "id": "d",
          "text": "High median"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Random assignment is the key design feature for causal conclusions.",
      "hint": "Assignment matters more than sample size alone.",
      "difficulty": "medium",
      "subskill_tags": [
        "causation",
        "randomization"
      ],
      "media": null
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "A lurking variable is one that:",
      "choices": [
        {
          "id": "a",
          "text": "Is measured and controlled perfectly"
        },
        {
          "id": "b",
          "text": "May affect the response but is not included"
        },
        {
          "id": "c",
          "text": "Is always the response variable"
        },
        {
          "id": "d",
          "text": "Must be the sample size"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Lurking variables are omitted variables that may influence results.",
      "hint": "Hidden influence.",
      "difficulty": "medium",
      "subskill_tags": [
        "lurking-variable"
      ],
      "media": null
    },
    {
      "id": "q9",
      "type": "multiple_choice",
      "prompt": "If subjects know they got the real treatment, their responses may change because of:",
      "choices": [
        {
          "id": "a",
          "text": "Cluster sampling"
        },
        {
          "id": "b",
          "text": "Placebo effect"
        },
        {
          "id": "c",
          "text": "Response bias or expectation effect"
        },
        {
          "id": "d",
          "text": "Sampling distribution"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "Knowledge of treatment can influence behavior or reporting.",
      "hint": "Think expectations.",
      "difficulty": "medium",
      "subskill_tags": [
        "blinding",
        "bias"
      ],
      "media": null
    },
    {
      "id": "q10",
      "type": "multiple_choice",
      "prompt": "Replication in an experiment means:",
      "choices": [
        {
          "id": "a",
          "text": "Using one subject carefully"
        },
        {
          "id": "b",
          "text": "Applying treatments to enough subjects"
        },
        {
          "id": "c",
          "text": "Sampling from many cities only"
        },
        {
          "id": "d",
          "text": "Repeating the same graph"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Replication means enough experimental units per treatment.",
      "hint": "Think repeated treatment application.",
      "difficulty": "medium",
      "subskill_tags": [
        "replication"
      ],
      "media": null
    }
  ]
}