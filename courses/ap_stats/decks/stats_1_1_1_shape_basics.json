      "type": "multiple_choice",
      "prompt": "A distribution with a long tail to the right is best described as:",
      "choices": [
        {
          "id": "a",
          "text": "Skewed left"
        },
        {
          "id": "b",
          "text": "Skewed right"
        },
        {
          "id": "c",
          "text": "Symmetric"
        },
        {
          "id": "d",
          "text": "Uniform"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A long right tail means the distribution is skewed right.",
      "hint": "Look at the direction of the tail.",
      "difficulty": "easy",
      "subskill_tags": [
        "shape",
        "skew"
      ],
