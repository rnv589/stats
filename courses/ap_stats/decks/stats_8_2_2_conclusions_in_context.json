      "id": "q1",
      "type": "multiple_choice",
      "prompt": "If p-value = 0.03 and \u03b1 = 0.05, the correct conclusion is:",
      "choices": [
        {
          "id": "a",
          "text": "Fail to reject H0"
        },
        {
          "id": "b",
          "text": "Reject H0; there is statistically significant evidence for Ha"
        },
        {
          "id": "c",
          "text": "Accept H0 as true"
        },
        {
          "id": "d",
          "text": "No data conclusion"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Since 0.03 < 0.05, reject H0.",
      "hint": "Compare p to alpha.",
      "difficulty": "hard",
      "subskill_tags": [
        "hypothesis-test",
        "conclusion"
      ],
      "media": {
        "image": "media/images/stats_8_2_2_conclusions_in_context_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "If p-value = 0.12 and \u03b1 = 0.05, the correct conclusion is:",
      "choices": [
        {
          "id": "a",
          "text": "Reject H0"
        },
        {
          "id": "b",
          "text": "Fail to reject H0; evidence is not strong enough"
        },
        {
          "id": "c",
          "text": "The null is proven"
        },
        {
          "id": "d",
          "text": "The alternative is impossible"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Since 0.12 > 0.05, do not reject H0.",
      "hint": "Insufficient evidence.",
      "difficulty": "hard",
      "subskill_tags": [
        "hypothesis-test",
        "conclusion"
      ],
      "media": {
        "image": "media/images/stats_8_2_2_conclusions_in_context_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Which wording is best after failing to reject H0?",
      "choices": [
        {
          "id": "a",
          "text": "There is no difference"
        },
        {
          "id": "b",
          "text": "There is not convincing evidence of a difference"
        },
        {
          "id": "c",
          "text": "H0 is definitely true"
        },
        {
          "id": "d",
          "text": "The experiment failed"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Failing to reject means not enough evidence, not proof of equality.",
      "hint": "Use careful language.",
      "difficulty": "hard",
      "subskill_tags": [
        "hypothesis-test",
        "communication"
      ],
      "media": {
        "image": "media/images/stats_8_2_2_conclusions_in_context_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Which wording is best after rejecting H0?",
      "choices": [
        {
          "id": "a",
          "text": "The alternative is proven absolutely"
        },
        {
          "id": "b",
          "text": "There is convincing evidence in favor of the alternative claim"
        },
        {
          "id": "c",
          "text": "The sample mean equals the parameter"
        },
        {
          "id": "d",
          "text": "The null has probability 0"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Hypothesis testing gives evidence, not absolute proof.",
