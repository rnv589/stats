      "id": "q1",
      "type": "multiple_choice",
      "prompt": "To use a normal model for p-hat, AP Stats commonly checks whether:",
      "choices": [
        {
          "id": "a",
          "text": "np and n(1-p) are both large enough"
        },
        {
          "id": "b",
          "text": "The population is exactly normal"
        },
        {
          "id": "c",
          "text": "The sample median is known"
        },
        {
          "id": "d",
          "text": "The data are categorical and quantitative"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Large counts support a nearly normal sampling distribution.",
      "hint": "Think success-failure condition.",
      "difficulty": "medium",
      "subskill_tags": [
        "sampling-distribution",
        "normal-condition"
      ],
      "media": {
        "image": "media/images/stats_6_1_2_normal_approximation_logic_1.png"
      }
    },
    {
