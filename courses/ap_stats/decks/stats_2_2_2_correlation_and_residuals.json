        {
          "id": "c",
          "text": "The form becomes curved"
        },
        {
          "id": "d",
          "text": "Outliers appear"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "r is unitless and unchanged by linear unit conversions.",
      "hint": "Think standardization.",
      "difficulty": "medium",
      "subskill_tags": [
        "correlation",
        "units"
      ],
      "media": null
    },
    {
