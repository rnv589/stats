      "choices": [
        {
          "id": "a",
          "text": "Slope of the line"
        },
        {
          "id": "b",
          "text": "Direction and strength of linear association"
        },
        {
          "id": "c",
          "text": "Cause-and-effect strength"
        },
        {
          "id": "d",
          "text": "Spread of one variable"
        }
      ],
      "correct_choice_id": "b",
