    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "A residual equals:",
      "choices": [
        {
          "id": "a",
          "text": "Observed y minus predicted y"
        },
        {
          "id": "b",
          "text": "Predicted y minus observed y"
        },
        {
          "id": "c",
          "text": "x minus mean"
        },
        {
          "id": "d",
          "text": "y minus median"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Residual = observed - predicted.",
      "hint": "Remember actual minus fit.",
      "difficulty": "medium",
      "subskill_tags": [
        "residuals"
      ],
      "media": {
        "image": "media/images/stats_2_2_2_correlation_and_residuals_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "A positive residual means the actual point is:",
      "choices": [
        {
          "id": "a",
          "text": "Below the line"
        },
        {
          "id": "b",
          "text": "On the line"
        },
        {
          "id": "c",
          "text": "Above the line"
        },
        {
          "id": "d",
          "text": "Not in the data"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "If observed > predicted, the point is above the line.",
      "hint": "Positive means actual is larger.",
      "difficulty": "medium",
      "subskill_tags": [
        "residuals"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "A residual of 0 means the point lies:",
      "choices": [
        {
          "id": "a",
          "text": "Above the line"
        },
        {
          "id": "b",
          "text": "Below the line"
        },
        {
          "id": "c",
          "text": "Exactly on the regression line"
        },
        {
          "id": "d",
          "text": "At the intercept"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "Observed equals predicted, so the point is on the line.",
      "hint": "No error from the line.",
      "difficulty": "medium",
      "subskill_tags": [
        "residuals"
      ],
      "media": null
    },
    {
