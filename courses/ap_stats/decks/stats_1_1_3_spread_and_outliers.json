    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Which measure describes the spread of the middle 50% of data?",
      "choices": [
        {
          "id": "a",
          "text": "Range"
        },
        {
          "id": "b",
          "text": "IQR"
        },
        {
          "id": "c",
          "text": "Mean"
        },
        {
          "id": "d",
          "text": "Median"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "The IQR is Q3 minus Q1 and covers the middle half.",
      "hint": "Think quartiles.",
      "difficulty": "easy",
      "subskill_tags": [
        "spread",
        "iqr"
      ],
      "media": {
        "image": "media/images/stats_1_1_3_spread_and_outliers_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Which measure uses the maximum and minimum only?",
      "choices": [
        {
          "id": "a",
          "text": "IQR"
        },
        {
          "id": "b",
          "text": "Range"
        },
        {
          "id": "c",
          "text": "Standard deviation"
        },
        {
          "id": "d",
          "text": "Median"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Range is max minus min.",
      "hint": "Only two endpoints are used.",
      "difficulty": "easy",
      "subskill_tags": [
        "spread",
        "range"
      ],
      "media": {
        "image": "media/images/stats_1_1_3_spread_and_outliers_2.png"
      }
    },
    {
      "id": "q3",
      "type": "numeric",
      "prompt": "If Q1 = 10 and Q3 = 18, what is the IQR?",
      "correct_numeric": 8,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "IQR = Q3 - Q1 = 18 - 10 = 8.",
      "hint": "Subtract Q1 from Q3.",
      "difficulty": "easy",
      "subskill_tags": [
        "spread",
        "iqr"
      ],
      "media": {
        "image": "media/images/stats_1_1_3_spread_and_outliers_3.png"
      }
    },
    {
      "id": "q4",
      "type": "numeric",
      "prompt": "If the minimum is 3 and the maximum is 15, what is the range?",
      "correct_numeric": 12,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "Range = max - min = 15 - 3 = 12.",
      "hint": "Use endpoints only.",
      "difficulty": "easy",
      "subskill_tags": [
        "spread",
        "range"
      ],
      "media": {
        "image": "media/images/stats_1_1_3_spread_and_outliers_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "An outlier is a value that is:",
      "choices": [
        {
          "id": "a",
          "text": "Exactly the median"
        },
        {
          "id": "b",
          "text": "Unusually far from the rest"
        },
        {
          "id": "c",
          "text": "Always the maximum"
        },
        {
          "id": "d",
          "text": "Always below Q1"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Outliers stand apart from the rest of the data.",
