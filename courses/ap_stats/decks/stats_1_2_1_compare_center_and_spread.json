      "prompt": "Two boxplots have the same median, but Plot A has a larger IQR. Which is true?",
      "choices": [
        {
          "id": "a",
          "text": "A has more spread in the middle 50%"
        },
        {
          "id": "b",
          "text": "A has less spread"
        },
        {
          "id": "c",
          "text": "Both have same variability"
        },
        {
          "id": "d",
          "text": "Cannot compare"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Larger IQR means more middle spread.",
      "hint": "Compare box lengths.",
      "difficulty": "medium",
      "subskill_tags": [
        "comparison",
        "iqr"
