  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "If a 95% confidence interval for \u03bc1\u2212\u03bc2 is entirely above 0, that suggests:",
      "choices": [
        {
          "id": "a",
          "text": "\u03bc1 may be less than \u03bc2"
        },
        {
          "id": "b",
          "text": "\u03bc1 is likely greater than \u03bc2"
        },
        {
          "id": "c",
          "text": "There is no difference"
        },
        {
          "id": "d",
          "text": "The sample means are equal"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "An interval above 0 suggests the true difference \u03bc1\u2212\u03bc2 is positive.",
      "hint": "Sign of the interval matters.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "interpretation"
      ],
      "media": {
        "image": "media/images/stats_7_2_1_two_sample_interval_choice_and_interpretation_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "If a confidence interval for p1\u2212p2 includes 0, that suggests:",
      "choices": [
        {
          "id": "a",
          "text": "A significant difference is supported"
        },
        {
          "id": "b",
          "text": "No clear evidence of a difference at that confidence level"
        },
        {
          "id": "c",
          "text": "p1 must equal p2 exactly"
        },
        {
          "id": "d",
          "text": "The interval is wrong"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Including 0 means no clear nonzero difference is supported.",
      "hint": "Zero is a plausible difference.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "interpretation"
      ],
      "media": {
        "image": "media/images/stats_7_2_1_two_sample_interval_choice_and_interpretation_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Two-sample procedures require the samples to be:",
      "choices": [
        {
          "id": "a",
          "text": "Always equal size"
        },
        {
          "id": "b",
          "text": "Independent or appropriately paired"
        },
        {
          "id": "c",
          "text": "Normally distributed populations only"
        },
        {
          "id": "d",
          "text": "Drawn from the same person"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Independence or valid pairing is the structural requirement.",
      "hint": "Check sample relationship.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "conditions"
      ],
      "media": {
        "image": "media/images/stats_7_2_1_two_sample_interval_choice_and_interpretation_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Which situation calls for a matched-pairs interval?",
