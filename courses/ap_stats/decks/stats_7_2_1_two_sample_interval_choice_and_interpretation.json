    {
      "id": "q9",
      "type": "multiple_choice",
      "prompt": "Which phrase best explains why 0 matters in a difference interval?",
      "choices": [
        {
          "id": "a",
          "text": "0 means no overlap in samples"
        },
        {
          "id": "b",
          "text": "0 means no difference in the parameter"
        },
        {
          "id": "c",
          "text": "0 means no outliers"
        },
        {
          "id": "d",
          "text": "0 means equal sample sizes"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "For a difference, 0 represents no effect or no difference.",
      "hint": "Zero is the null value for a difference.",
      "difficulty": "hard",
