        {
          "id": "b",
          "text": "Before-and-after blood pressure on the same patients"
        },
        {
          "id": "c",
          "text": "Comparing two schools chosen independently"
        },
        {
          "id": "d",
          "text": "Comparing two brands with different shoppers"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Same subjects measured twice create paired data.",
      "hint": "One subject, two measurements.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "matched-pairs"
      ],
      "media": {
        "image": "media/images/stats_7_2_1_two_sample_interval_choice_and_interpretation_4.png"
