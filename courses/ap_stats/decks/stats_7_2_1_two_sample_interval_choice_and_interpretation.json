        {
          "id": "a",
          "text": "95% of sample differences are in the interval"
        },
        {
          "id": "b",
          "text": "We are 95% confident the true difference in population means lies in the interval"
        },
        {
          "id": "c",
          "text": "95% of population values are in the interval"
        },
        {
          "id": "d",
          "text": "The null is definitely false"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Interpret the interval in terms of the parameter difference.",
      "hint": "Parameter, not sample values.",
      "difficulty": "hard",
      "subskill_tags": [
        "confidence-interval",
        "interpretation"
      ],
      "media": null
    },
    {
