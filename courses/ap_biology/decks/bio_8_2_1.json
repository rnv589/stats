      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Competition occurs when organisms use the same limited:",
      "choices": [
        {
          "id": "a",
          "text": "Gene"
        },
        {
          "id": "b",
          "text": "Resource"
        },
        {
          "id": "c",
          "text": "Chromosome"
        },
        {
          "id": "d",
          "text": "Ribosome"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Competition is strongest when species overlap in resource needs.",
      "difficulty": "medium",
      "subskill_tags": [
        "competition"
      ],
      "media": null
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Two species cannot occupy exactly the same niche indefinitely because of:",
      "choices": [
        {
          "id": "a",
          "text": "Hardy-Weinberg equilibrium"
        },
        {
          "id": "b",
          "text": "Competitive exclusion"
        },
        {
          "id": "c",
          "text": "Chemiosmosis"
        },
        {
          "id": "d",
          "text": "Independent assortment"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Competitive exclusion predicts that complete niche overlap is unstable.",
      "difficulty": "medium",
      "subskill_tags": [
        "niche"
      ],
      "media": null
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Mutualism is an interaction in which:",
      "choices": [
        {
          "id": "a",
          "text": "One species benefits and the other is harmed"
        },
        {
          "id": "b",
          "text": "Both species benefit"
        },
        {
          "id": "c",
          "text": "Neither species is affected"
        },
        {
          "id": "d",
          "text": "One species always dies"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Both species gain in a mutualistic interaction.",
      "difficulty": "medium",
      "subskill_tags": [
        "species-interactions"
      ],
      "media": null
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Commensalism is an interaction in which:",
      "choices": [
        {
          "id": "a",
          "text": "Both benefit"
        },
        {
          "id": "b",
          "text": "One benefits and the other is unaffected"
        },
        {
          "id": "c",
          "text": "Both are harmed"
        },
        {
          "id": "d",
          "text": "One benefits and one is harmed"
        }
