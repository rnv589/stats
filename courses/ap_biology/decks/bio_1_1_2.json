      "correct_choice_id": "b",
      "explanation": "High temperatures can disrupt protein shape and denature the enzyme.",
      "difficulty": "medium",
      "subskill_tags": [
        "enzymes",
        "temperature"
      ],
      "media": null
    },
    {
