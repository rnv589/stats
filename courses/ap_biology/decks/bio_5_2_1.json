      "subskill_tags": [
        "pedigree"
      ],
      "media": null
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "A recessive trait can appear in offspring of two unaffected parents if both parents are:",
      "choices": [
        {
          "id": "a",
          "text": "Homozygous dominant"
        },
        {
          "id": "b",
          "text": "Carriers"
        },
        {
          "id": "c",
          "text": "Affected"
        },
        {
          "id": "d",
          "text": "Polygenic"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Two heterozygous carriers can produce a recessive homozygote.",
      "difficulty": "medium",
      "subskill_tags": [
        "recessive"
      ],
      "media": null
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "A trait passed from an affected father to all daughters but no sons is most consistent with:",
      "choices": [
        {
          "id": "a",
          "text": "Y-linked inheritance"
        },
        {
          "id": "b",
          "text": "X-linked dominant inheritance"
        },
        {
          "id": "c",
          "text": "Autosomal recessive inheritance"
        },
        {
          "id": "d",
          "text": "Mitochondrial inheritance"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Fathers pass their X chromosome to daughters, not sons.",
      "difficulty": "medium",
      "subskill_tags": [
        "sex-linked"
      ],
      "media": null
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "Mitochondrial traits are usually inherited from the:",
      "choices": [
        {
          "id": "a",
          "text": "Father only"
        },
        {
          "id": "b",
          "text": "Mother only"
        },
        {
          "id": "c",
          "text": "Any grandparent equally"
        },
        {
          "id": "d",
          "text": "Older sibling"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Mitochondria are typically inherited through the egg.",
      "difficulty": "medium",
      "subskill_tags": [
        "mitochondrial"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "Which pattern is most characteristic of a Y-linked trait?",
      "choices": [
        {
          "id": "a",
          "text": "Passed from fathers to all sons"
        },
        {
          "id": "b",
          "text": "Passed from mothers to sons only"
        },
        {
          "id": "c",
          "text": "Appears only in females"
        },
        {
          "id": "d",
          "text": "Skips every other generation"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Y-linked genes pass directly along the paternal line.",
      "difficulty": "medium",
      "subskill_tags": [
        "sex-linked"
      ],
      "media": null
    },
    {
      "id": "q7",
      "type": "multiple_choice",
      "prompt": "Why are males more likely to express X-linked recessive traits?",
      "choices": [
        {
          "id": "a",
          "text": "They have two X chromosomes"
        },
        {
          "id": "b",
          "text": "They have only one X chromosome"
        },
        {
          "id": "c",
          "text": "They never inherit X alleles from mothers"
        },
        {
          "id": "d",
          "text": "Their Y chromosome masks the X"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A single recessive allele on the X can be expressed in males.",
      "difficulty": "medium",
      "subskill_tags": [
        "sex-linked"
      ],
      "media": null
    },
