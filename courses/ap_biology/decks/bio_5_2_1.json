          "text": "Recessive"
        },
        {
          "id": "b",
          "text": "Dominant"
        },
        {
          "id": "c",
          "text": "Mitochondrial only"
        },
        {
          "id": "d",
          "text": "Polyploid"
        }
      ],
      "correct_choice_id": "b",
