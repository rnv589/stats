    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Which event generates variation by exchanging DNA between homologous chromosomes?",
      "choices": [
        {
          "id": "a",
          "text": "Independent assortment"
        },
        {
          "id": "b",
          "text": "Crossing over"
        },
        {
          "id": "c",
          "text": "Fertilization"
        },
        {
          "id": "d",
          "text": "Mitosis"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Crossing over reshuffles alleles between homologs.",
      "difficulty": "medium",
      "subskill_tags": [
        "variation"
      ],
      "media": null
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Why does independent assortment increase genetic variation?",
      "choices": [
        {
          "id": "a",
          "text": "Each homologous pair aligns randomly in meiosis I"
        },
        {
          "id": "b",
          "text": "DNA never replicates"
        },
        {
          "id": "c",
          "text": "All genes are on different chromosomes"
        },
        {
          "id": "d",
          "text": "Gametes become diploid"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Random orientation of chromosome pairs produces many possible combinations.",
      "difficulty": "medium",
      "subskill_tags": [
        "independent-assortment"
      ],
      "media": null
    },
    {
