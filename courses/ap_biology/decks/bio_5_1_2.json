        },
        {
          "id": "b",
          "text": "Polygenic inheritance and environmental effects"
        },
        {
          "id": "c",
          "text": "The absence of DNA"
        },
        {
          "id": "d",
          "text": "A lack of reproduction"
        }
      ],
      "correct_choice_id": "b",
