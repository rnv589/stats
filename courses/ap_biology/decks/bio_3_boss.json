      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Which statement best links photosynthesis and respiration?",
      "choices": [
        {
          "id": "a",
          "text": "Photosynthesis destroys ATP permanently"
        },
        {
          "id": "b",
          "text": "Products of one can serve as reactants for the other"
        },
        {
          "id": "c",
          "text": "Both occur only in animals"
        },
        {
          "id": "d",
          "text": "Both require oxygen as an input"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Glucose and oxygen from photosynthesis feed respiration, while CO₂ and water from respiration feed photosynthesis.",
      "difficulty": "medium",
      "subskill_tags": [
        "energetics"
      ],
      "media": null
    },
