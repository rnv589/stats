      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Homeostasis refers to the maintenance of:",
      "choices": [
        {
          "id": "a",
          "text": "A constant external environment"
        },
        {
          "id": "b",
          "text": "Relatively stable internal conditions"
        },
        {
          "id": "c",
          "text": "Identical gene expression in all cells"
        },
        {
          "id": "d",
          "text": "Only body temperature"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Homeostasis keeps internal conditions within workable ranges.",
      "difficulty": "medium",
      "subskill_tags": [
        "homeostasis"
      ],
      "media": null
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "When blood glucose rises and insulin promotes uptake of glucose by cells, the system is showing:",
      "choices": [
        {
          "id": "a",
          "text": "Positive feedback"
        },
        {
          "id": "b",
          "text": "Negative feedback"
        },
        {
          "id": "c",
          "text": "No regulation"
        },
        {
          "id": "d",
          "text": "Cell differentiation"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "The response counteracts the initial change, which is negative feedback.",
      "difficulty": "medium",
      "subskill_tags": [
        "feedback"
      ],
      "media": null
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Positive feedback is best illustrated by:",
