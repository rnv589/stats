      "difficulty": "medium",
      "subskill_tags": [
        "mutation"
      ],
      "media": null
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "If two populations can no longer interbreed successfully, they are:",
      "choices": [
        {
          "id": "a",
          "text": "In Hardy-Weinberg equilibrium"
        },
        {
          "id": "b",
          "text": "Reproductively isolated"
        },
        {
          "id": "c",
          "text": "Under gene flow"
        },
        {
          "id": "d",
          "text": "Members of the same deme"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Reproductive isolation is central to speciation.",
      "difficulty": "medium",
      "subskill_tags": [
        "speciation"
      ],
      "media": null
    },
    {
