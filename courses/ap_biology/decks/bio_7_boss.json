        {
          "id": "a",
          "text": "Gene flow"
        },
        {
          "id": "b",
          "text": "Genetic drift"
        },
        {
          "id": "c",
          "text": "Sexual selection"
        },
        {
          "id": "d",
          "text": "Artificial selection"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Both involve random shifts in allele frequencies due to small population size.",
      "difficulty": "medium",
      "subskill_tags": [
        "genetic-drift"
      ],
      "media": null
    },
    {
