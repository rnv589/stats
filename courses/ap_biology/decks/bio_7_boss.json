  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "Which statement about natural selection is most accurate?",
      "choices": [
        {
          "id": "a",
          "text": "Individuals adapt because they need to"
        },
        {
          "id": "b",
          "text": "Individuals with heritable traits that improve fitness leave more offspring"
        },
        {
          "id": "c",
          "text": "All traits are equally favored"
        },
        {
          "id": "d",
          "text": "Selection changes alleles directly by intention"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Selection acts on heritable variation and changes populations over generations.",
      "difficulty": "medium",
      "subskill_tags": [
        "natural-selection"
      ],
      "media": null
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "What does genetic drift describe?",
      "choices": [
        {
          "id": "a",
          "text": "Adaptive change caused by selection"
        },
        {
          "id": "b",
          "text": "Random change in allele frequencies, especially in small populations"
        },
        {
          "id": "c",
          "text": "Movement of alleles between populations"
        },
        {
          "id": "d",
          "text": "DNA replication errors only"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Drift is chance-based rather than adaptive.",
      "difficulty": "medium",
      "subskill_tags": [
        "genetic-drift"
      ],
      "media": null
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Which process most directly increases similarity between populations?",
      "choices": [
        {
          "id": "a",
          "text": "Speciation"
        },
        {
          "id": "b",
          "text": "Gene flow"
        },
        {
          "id": "c",
          "text": "Directional selection"
        },
        {
          "id": "d",
          "text": "Bottleneck effect"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Migration tends to homogenize populations.",
      "difficulty": "medium",
      "subskill_tags": [
        "gene-flow"
      ],
      "media": null
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "What is the immediate source of new genetic variation?",
      "choices": [
        {
          "id": "a",
          "text": "Natural selection"
        },
        {
          "id": "b",
          "text": "Mutation"
        },
        {
          "id": "c",
          "text": "Gene flow"
        },
        {
          "id": "d",
          "text": "Meiosis II"
        }
      ],
      "correct_choice_id": "b",
