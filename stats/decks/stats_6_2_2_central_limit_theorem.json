      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "If the population is strongly skewed, what helps x-bar become more normal?",
      "choices": [
        {
          "id": "a",
          "text": "Smaller n"
        },
        {
          "id": "b",
          "text": "Larger n"
        },
        {
          "id": "c",
          "text": "Changing units"
        },
        {
          "id": "d",
          "text": "Using a boxplot"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A larger sample size helps overcome skewness in the population.",
      "hint": "Need enough sample size.",
      "difficulty": "hard",
      "subskill_tags": [
        "clt",
        "sample-size"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "Which statement is true?",
      "choices": [
        {
          "id": "a",
          "text": "The CLT guarantees the sample data are normal"
        },
        {
          "id": "b",
          "text": "The CLT concerns sample means, not individual observations"
        },
        {
          "id": "c",
          "text": "The CLT makes bias disappear"
        },
        {
          "id": "d",
          "text": "The CLT only works for proportions"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "The theorem is about the distribution of x-bar.",
      "hint": "Do not confuse raw data with the statistic.",
      "difficulty": "hard",
      "subskill_tags": [
        "clt"
      ],
      "media": null
    },
    {
