        {
          "id": "a",
          "text": "Reasonable"
        },
        {
          "id": "b",
          "text": "Questionable"
        },
        {
          "id": "c",
          "text": "Guaranteed"
        },
        {
          "id": "d",
          "text": "Required"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Small n may not overcome strong skewness.",
      "hint": "Be cautious when n is small.",
      "difficulty": "hard",
      "subskill_tags": [
        "clt",
        "limitations"
      ],
      "media": null
    },
