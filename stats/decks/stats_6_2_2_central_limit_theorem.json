  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "The Central Limit Theorem says that for large n, the distribution of x-bar is approximately normal when:",
      "choices": [
        {
          "id": "a",
          "text": "The population is categorical"
        },
        {
          "id": "b",
          "text": "The population distribution can be any shape, under suitable conditions"
        },
        {
          "id": "c",
          "text": "n = 2 only"
        },
        {
          "id": "d",
          "text": "The sample is biased"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "For sufficiently large samples, x-bar is approximately normal even from nonnormal populations.",
      "hint": "Large n smooths things out.",
      "difficulty": "hard",
      "subskill_tags": [
        "clt"
      ],
      "media": {
        "image": "media/images/stats_6_2_2_central_limit_theorem_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "If the population is already normal, the distribution of x-bar is:",
      "choices": [
        {
          "id": "a",
          "text": "Approximately normal only for large n"
        },
        {
          "id": "b",
          "text": "Exactly normal for any n"
        },
        {
          "id": "c",
          "text": "Skewed right always"
        },
        {
          "id": "d",
          "text": "Uniform"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Normal populations produce normal sample means for any sample size.",
      "hint": "This is stronger than the CLT.",
      "difficulty": "hard",
      "subskill_tags": [
        "clt",
        "normal-population"
      ],
      "media": {
        "image": "media/images/stats_6_2_2_central_limit_theorem_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "As n increases, the sampling distribution of x-bar typically becomes:",
      "choices": [
        {
          "id": "a",
          "text": "Less normal"
        },
        {
          "id": "b",
          "text": "More nearly normal"
        },
        {
          "id": "c",
          "text": "More skewed"
        },
        {
          "id": "d",
          "text": "Categorical"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Larger sample sizes make x-bar more nearly normal.",
