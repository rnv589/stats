    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "A slope of 0.8 means:",
      "choices": [
        {
          "id": "a",
          "text": "y increases by 0.8 for each 1-unit increase in x"
        },
        {
          "id": "b",
          "text": "x increases by 0.8 for each 1-unit increase in y"
        },
        {
          "id": "c",
