    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "In a regression equation y = a + bx, the slope b tells:",
      "choices": [
        {
          "id": "a",
          "text": "Predicted y when x = 0"
        },
        {
          "id": "b",
          "text": "Change in predicted y for 1-unit increase in x"
        },
        {
          "id": "c",
          "text": "Strength of association only"
        },
        {
          "id": "d",
          "text": "Whether data are categorical"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Slope is the predicted change in y for each 1-unit increase in x.",
      "hint": "Think rate of change.",
      "difficulty": "medium",
      "subskill_tags": [
        "regression",
        "slope"
      ],
      "media": {
        "image": "media/images/stats_2_2_1_slope_and_intercept_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "The intercept in a regression equation represents:",
      "choices": [
        {
          "id": "a",
          "text": "The average x"
        },
        {
          "id": "b",
          "text": "The predicted y when x = 0"
        },
        {
          "id": "c",
          "text": "The correlation"
        },
        {
          "id": "d",
          "text": "The residual"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "The intercept is the predicted response at x = 0.",
      "hint": "Set x equal to zero.",
      "difficulty": "medium",
      "subskill_tags": [
        "regression",
        "intercept"
      ],
      "media": {
        "image": "media/images/stats_2_2_1_slope_and_intercept_2.png"
      }
    },
    {
