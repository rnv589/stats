      "difficulty": "medium",
      "subskill_tags": [
        "regression",
        "interpretation"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "Why can the intercept sometimes be meaningless in context?",
      "choices": [
        {
          "id": "a",
          "text": "It is never part of the line"
        },
        {
          "id": "b",
          "text": "x = 0 may be outside the realistic data range"
        },
        {
          "id": "c",
          "text": "It equals the median"
        },
        {
          "id": "d",
          "text": "It is always negative"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "If x = 0 is unrealistic, the intercept may have no practical meaning.",
      "hint": "Check the context.",
      "difficulty": "medium",
      "subskill_tags": [
        "regression",
        "intercept"
      ],
      "media": null
    },
