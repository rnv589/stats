    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "If slope = -3, then as x increases by 1, predicted y:",
      "choices": [
        {
          "id": "a",
          "text": "Increases by 3"
        },
        {
          "id": "b",
          "text": "Decreases by 3"
        },
        {
          "id": "c",
          "text": "Stays the same"
        },
        {
          "id": "d",
          "text": "Doubles"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "A negative slope means predicted y decreases.",
      "hint": "Watch the sign.",
      "difficulty": "medium",
      "subskill_tags": [
        "regression",
        "slope"
      ],
      "media": {
        "image": "media/images/stats_2_2_1_slope_and_intercept_4.png"
      }
