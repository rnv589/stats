      "type": "multiple_choice",
      "prompt": "Which scenario is geometric?",
      "choices": [
        {
          "id": "a",
          "text": "Roll a die 8 times and count sixes"
        },
        {
          "id": "b",
          "text": "Flip a coin until the first head"
