      "id": "q1",
      "type": "multiple_choice",
      "prompt": "A geometric random variable counts:",
      "choices": [
        {
          "id": "a",
          "text": "Successes in n trials"
        },
        {
          "id": "b",
          "text": "Trials until first success"
        },
        {
          "id": "c",
          "text": "Failures only"
        },
        {
          "id": "d",
          "text": "Means of samples"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Geometric variables count how many trials are needed to get the first success.",
      "hint": "Think first success.",
      "difficulty": "medium",
      "subskill_tags": [
        "geometric",
        "definition"
      ],
      "media": {
        "image": "media/images/stats_5_2_1_geometric_recognition_and_mean_1.png"
      }
