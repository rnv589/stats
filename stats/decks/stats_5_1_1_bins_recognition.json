      "type": "multiple_choice",
      "prompt": "Which is NOT a binomial condition?",
      "choices": [
        {
          "id": "a",
          "text": "Fixed number of trials"
        },
        {
          "id": "b",
          "text": "Independent trials"
        },
        {
          "id": "c",
          "text": "Same probability of success"
        },
        {
          "id": "d",
          "text": "More than one type of success allowed on each trial"
        }
      ],
      "correct_choice_id": "d",
      "explanation": "Each trial must have exactly two outcomes: success or failure.",
      "hint": "Think binary outcomes.",
