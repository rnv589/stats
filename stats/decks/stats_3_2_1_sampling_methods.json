      "type": "multiple_choice",
      "prompt": "Which sampling method usually gives the most representative sample when important groups differ?",
      "choices": [
        {
          "id": "a",
          "text": "Convenience"
        },
        {
          "id": "b",
          "text": "Stratified"
        },
        {
          "id": "c",
          "text": "Voluntary response"
        },
        {
          "id": "d",
          "text": "Undercoverage"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Stratified sampling ensures key groups are represented.",
      "hint": "Useful when groups differ.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "stratified"
      ],
      "media": null
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "Which method relies on a numbered list and a random process to pick individuals?",
      "choices": [
        {
          "id": "a",
          "text": "SRS"
        },
        {
          "id": "b",
          "text": "Convenience"
        },
        {
          "id": "c",
          "text": "Voluntary response"
        },
        {
          "id": "d",
          "text": "Quota"
        }
      ],
      "correct_choice_id": "a",
