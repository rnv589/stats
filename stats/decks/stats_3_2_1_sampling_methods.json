  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "In a simple random sample, every sample of a given size has:",
      "choices": [
        {
          "id": "a",
          "text": "Different chance"
        },
        {
          "id": "b",
          "text": "The same chance"
        },
        {
          "id": "c",
          "text": "No chance"
        },
        {
          "id": "d",
          "text": "A biased chance"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "SRS means all samples of that size are equally likely.",
      "hint": "Equal chance is the key.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "srs"
      ],
      "media": {
        "image": "media/images/stats_3_2_1_sampling_methods_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "A stratified sample divides the population into groups and then:",
      "choices": [
        {
          "id": "a",
          "text": "Chooses whole groups only"
        },
        {
          "id": "b",
          "text": "Randomly samples within each group"
        },
        {
          "id": "c",
          "text": "Uses convenience sampling"
        },
        {
          "id": "d",
          "text": "Surveys volunteers"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Stratified sampling samples within each stratum.",
      "hint": "Think split then sample.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "stratified"
      ],
      "media": {
        "image": "media/images/stats_3_2_1_sampling_methods_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "A cluster sample typically:",
      "choices": [
        {
          "id": "a",
          "text": "Samples individuals from every group"
        },
        {
          "id": "b",
          "text": "Randomly selects whole groups and surveys everyone in them"
        },
        {
          "id": "c",
          "text": "Uses every 10th person only"
        },
        {
          "id": "d",
          "text": "Chooses people by convenience"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Cluster sampling selects whole groups.",
      "hint": "Whole groups are the clue.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "cluster"
      ],
      "media": {
        "image": "media/images/stats_3_2_1_sampling_methods_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "A systematic sample might select:",
      "choices": [
        {
          "id": "a",
          "text": "Every 10th name on a roster after a random start"
        },
        {
          "id": "b",
          "text": "Only seniors"
        },
        {
          "id": "c",
          "text": "All volunteers"
        },
        {
          "id": "d",
          "text": "One random class from each grade"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Systematic sampling uses every kth item after a random start.",
      "hint": "Think pattern interval.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "systematic"
      ],
      "media": {
        "image": "media/images/stats_3_2_1_sampling_methods_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "If a school separates students by grade level and samples randomly from each grade, that is:",
      "choices": [
        {
          "id": "a",
          "text": "Cluster"
        },
        {
          "id": "b",
          "text": "Convenience"
        },
        {
          "id": "c",
          "text": "Stratified"
        },
        {
          "id": "d",
          "text": "Systematic"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "Grade levels are strata.",
      "hint": "Sample inside each group.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "stratified"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "If 5 classrooms are randomly chosen and every student in those rooms is surveyed, that is:",
      "choices": [
        {
          "id": "a",
          "text": "SRS"
        },
        {
          "id": "b",
          "text": "Cluster"
        },
        {
          "id": "c",
          "text": "Systematic"
        },
        {
          "id": "d",
          "text": "Voluntary response"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Whole classrooms were selected, so it is cluster sampling.",
      "hint": "Entire groups chosen.",
      "difficulty": "easy",
      "subskill_tags": [
        "sampling",
        "cluster"
      ],
      "media": null
    },
    {
