  "questions": [
    {
      "id": "q1",
      "type": "numeric",
      "prompt": "A random variable X takes values 0,1,2 with probabilities 0.2,0.5,0.3. What is E(X)?",
      "correct_numeric": 1.1,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "Compute 0(0.2)+1(0.5)+2(0.3)=1.1.",
      "hint": "Multiply values by probabilities and add.",
      "difficulty": "medium",
      "subskill_tags": [
        "expected-value"
      ],
      "media": {
        "image": "media/images/stats_4_2_1_expected_value_1.png"
      }
    },
    {
      "id": "q2",
      "type": "multiple_choice",
      "prompt": "Expected value is best interpreted as the:",
      "choices": [
        {
          "id": "a",
          "text": "Most likely single result"
        },
        {
          "id": "b",
          "text": "Long-run average outcome"
        },
        {
          "id": "c",
          "text": "Median outcome always"
        },
        {
          "id": "d",
          "text": "Largest possible value"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Expected value is the long-run average over many repetitions.",
      "hint": "Think average in the long run.",
      "difficulty": "medium",
      "subskill_tags": [
        "expected-value",
        "interpretation"
      ],
      "media": {
        "image": "media/images/stats_4_2_1_expected_value_2.png"
      }
    },
    {
      "id": "q3",
      "type": "numeric",
      "prompt": "A game pays $5 with probability 0.4 and $0 with probability 0.6. What is the expected payout?",
      "correct_numeric": 2,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "E(X)=5(0.4)+0(0.6)=2.",
      "hint": "Weighted average.",
      "difficulty": "medium",
      "subskill_tags": [
        "expected-value"
      ],
      "media": {
        "image": "media/images/stats_4_2_1_expected_value_3.png"
      }
    },
    {
      "id": "q4",
      "type": "multiple_choice",
      "prompt": "Expected value can be:",
      "choices": [
        {
          "id": "a",
          "text": "Only one of the possible outcomes"
        },
        {
          "id": "b",
          "text": "A number not actually obtainable on one trial"
        },
        {
          "id": "c",
          "text": "Only an integer"
        },
        {
          "id": "d",
          "text": "Always the median"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Long-run averages do not need to be possible single outcomes.",
      "hint": "Average need not be an actual result.",
      "difficulty": "medium",
      "subskill_tags": [
        "expected-value",
        "interpretation"
      ],
      "media": {
        "image": "media/images/stats_4_2_1_expected_value_4.png"
      }
    },
    {
      "id": "q5",
      "type": "numeric",
      "prompt": "A ticket wins $10 with probability 0.1 and loses $2 with probability 0.9. What is expected gain?",
      "correct_numeric": -0.8,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "10(0.1)+(-2)(0.9)=1-1.8=-0.8.",
      "hint": "Include both gains and losses.",
      "difficulty": "medium",
      "subskill_tags": [
        "expected-value"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "A positive expected value means in the long run you would expect to:",
      "choices": [
        {
          "id": "a",
          "text": "Lose money on average"
        },
        {
          "id": "b",
          "text": "Break even exactly each time"
        },
        {
          "id": "c",
          "text": "Gain on average"
        },
        {
          "id": "d",
          "text": "Always win"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "Positive expected value indicates average gain over many repetitions.",
      "hint": "Long-run advantage.",
      "difficulty": "medium",
      "subskill_tags": [
        "expected-value",
        "interpretation"
      ],
      "media": null
    },
    {
      "id": "q7",
      "type": "numeric",
      "prompt": "If X is constant at 4 every time, E(X) =",
      "correct_numeric": 4,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "A constant random variable has expected value equal to the constant.",
