      "subskill_tags": [
        "expected-value"
      ],
      "media": null
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "Which formula gives expected value for a discrete random variable?",
      "choices": [
        {
          "id": "a",
          "text": "\u03a3x"
        },
        {
          "id": "b",
          "text": "\u03a3p"
        },
        {
          "id": "c",
          "text": "\u03a3x\u00b7p(x)"
        },
        {
          "id": "d",
          "text": "x/p"
        }
      ],
      "correct_choice_id": "c",
