  "questions": [
    {
      "id": "q1",
      "type": "multiple_choice",
      "prompt": "P(A | B) means:",
      "choices": [
        {
          "id": "a",
          "text": "Probability of B given A"
        },
        {
          "id": "b",
          "text": "Probability of A given B"
        },
        {
          "id": "c",
          "text": "A and B together"
        },
        {
          "id": "d",
          "text": "A or B"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Conditional probability conditions on B having occurred.",
      "hint": "The bar means given.",
      "difficulty": "medium",
      "subskill_tags": [
        "conditional-probability"
      ],
      "media": {
        "image": "media/images/stats_4_1_2_conditional_probability_1.png"
      }
    },
    {
      "id": "q2",
      "type": "numeric",
      "prompt": "If P(A and B)=0.2 and P(B)=0.5, what is P(A|B)?",
      "correct_numeric": 0.4,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "Use P(A|B)=P(A and B)/P(B)=0.2/0.5=0.4.",
      "hint": "Divide joint by conditioning event.",
      "difficulty": "medium",
      "subskill_tags": [
        "conditional-probability"
      ],
      "media": {
        "image": "media/images/stats_4_1_2_conditional_probability_2.png"
      }
    },
    {
      "id": "q3",
      "type": "multiple_choice",
      "prompt": "Two events are independent if:",
      "choices": [
        {
          "id": "a",
          "text": "P(A|B)=P(A)"
        },
        {
          "id": "b",
          "text": "They cannot happen together"
        },
        {
          "id": "c",
          "text": "Their probabilities add to 1"
        },
        {
          "id": "d",
          "text": "One causes the other"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Independence means one event does not change the probability of the other.",
      "hint": "Think unchanged probability.",
      "difficulty": "medium",
      "subskill_tags": [
        "independence"
      ],
      "media": {
        "image": "media/images/stats_4_1_2_conditional_probability_3.png"
      }
    },
    {
      "id": "q4",
      "type": "numeric",
      "prompt": "If P(A)=0.3 and P(B)=0.4 and A,B are independent, what is P(A and B)?",
      "correct_numeric": 0.12,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "For independent events, multiply: 0.3\u00d70.4=0.12.",
      "hint": "Independent means multiply.",
      "difficulty": "medium",
      "subskill_tags": [
        "independence",
        "multiplication"
      ],
      "media": {
        "image": "media/images/stats_4_1_2_conditional_probability_4.png"
      }
    },
    {
      "id": "q5",
      "type": "multiple_choice",
      "prompt": "If events are disjoint and both have positive probability, they are:",
      "choices": [
        {
          "id": "a",
          "text": "Independent"
        },
        {
          "id": "b",
          "text": "Not independent"
        },
        {
          "id": "c",
          "text": "Always equal"
        },
        {
          "id": "d",
          "text": "Conditional"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Disjoint positive-probability events cannot be independent.",
      "hint": "Knowing one happened makes the other impossible.",
      "difficulty": "medium",
      "subskill_tags": [
        "independence",
        "disjoint"
      ],
      "media": null
    },
    {
      "id": "q6",
      "type": "multiple_choice",
      "prompt": "In a two-way table, a conditional probability uses:",
      "choices": [
        {
          "id": "a",
          "text": "A row or column total as the new denominator"
        },
        {
          "id": "b",
          "text": "The grand total always"
        },
        {
          "id": "c",
          "text": "Only the diagonal"
        },
        {
          "id": "d",
          "text": "No denominator"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Conditioning on a group changes the denominator to that group's total.",
      "hint": "Restrict the sample space.",
      "difficulty": "medium",
      "subskill_tags": [
        "conditional-probability",
        "tables"
      ],
      "media": null
    },
    {
      "id": "q7",
      "type": "numeric",
      "prompt": "A bag has 3 red and 2 blue marbles. What is P(red on first draw)?",
      "correct_numeric": 0.6,
      "tolerance": 0.01,
      "accepted_formats": [
        "integer",
        "decimal"
      ],
      "explanation": "3 out of 5 marbles are red.",
      "hint": "Favorable over total.",
      "difficulty": "medium",
      "subskill_tags": [
        "probability"
      ],
      "media": null
    },
    {
      "id": "q8",
      "type": "multiple_choice",
      "prompt": "If drawing without replacement, the draws are usually:",
      "choices": [
        {
          "id": "a",
          "text": "Independent"
        },
        {
          "id": "b",
          "text": "Dependent"
        },
        {
          "id": "c",
          "text": "Disjoint"
        },
        {
          "id": "d",
          "text": "Uniform"
        }
      ],
      "correct_choice_id": "b",
      "explanation": "Without replacement changes later probabilities, so the draws are dependent.",
      "hint": "The first draw changes the bag.",
      "difficulty": "medium",
      "subskill_tags": [
        "dependence"
      ],
      "media": null
    },
    {
      "id": "q9",
      "type": "multiple_choice",
      "prompt": "Which is true if A and B are independent?",
      "choices": [
        {
          "id": "a",
          "text": "P(A and B)=P(A)+P(B)"
        },
        {
          "id": "b",
          "text": "P(A|B)=0"
        },
        {
          "id": "c",
          "text": "P(A and B)=P(A)P(B)"
        },
        {
          "id": "d",
          "text": "A and B must be disjoint"
        }
      ],
      "correct_choice_id": "c",
      "explanation": "Multiplication is the hallmark of independence.",
      "hint": "Use product rule for independent events.",
      "difficulty": "medium",
      "subskill_tags": [
        "independence"
      ],
      "media": null
    },
    {
      "id": "q10",
      "type": "multiple_choice",
      "prompt": "Conditioning on event B means you now consider:",
      "choices": [
        {
          "id": "a",
          "text": "Only outcomes in B"
        },
        {
          "id": "b",
          "text": "Only outcomes not in B"
        },
        {
          "id": "c",
          "text": "The whole sample space unchanged"
        },
        {
          "id": "d",
          "text": "Only event A"
        }
      ],
      "correct_choice_id": "a",
      "explanation": "Conditional probability restricts attention to outcomes where B occurred.",
      "hint": "Shrink the sample space.",
      "difficulty": "medium",
      "subskill_tags": [
        "conditional-probability"
      ],
      "media": null
    }
  ]
